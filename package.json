{
  "name": "roast-and-toast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "tsup": {
      "esbuild": "^0.28.1"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:api": "node node_modules/tsx/dist/cli.mjs watch --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace @roast/web",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p apps/api/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js apps packages --max-warnings 0",
    "test": "node scripts/run-tool.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node scripts/run-tool.mjs node_modules/@playwright/test/cli.js test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:demo:plan": "node --env-file-if-exists=.env --import tsx scripts/cleanup-demo.ts",
    "db:demo:clean": "node --env-file-if-exists=.env --import tsx scripts/cleanup-demo.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@hookform/resolvers": "7.0.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.106.1",
    "better-auth": "1.7.17",
    "bullmq": "6.7.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.69.0",
    "multer": "2.5.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.84.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.4",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
