NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_PORT=4000
# Keep loopback for the combined app; use 0.0.0.0 only for a private separate API host.
API_HOST=127.0.0.1
# Set before the frontend build if the API runs on a different private host.
API_INTERNAL_URL=http://127.0.0.1:4000
# Demo records are opt-in and are never seeded in production.
SEED_DEMO=0
# Server-only. Supabase dashboard → Connect → Session pooler (port 5432).
# Paste the complete URI; percent-encode special characters in its password.
# Example: postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# Public Supabase root certificate; keeps TLS certificate verification enabled.
SUPABASE_DB_CA=supabase/certs/prod-ca-2021.crt
# Use a fresh random value of at least 32 characters. Never expose it with NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
# Production needs Redis for shared posting limits. Optional for local development.
REDIS_URL=
# Optional: private moderator login email delivery. Ordinary users never sign up.
SMTP_URL=
EMAIL_FROM="Roast & Toast <hello@example.com>"
ADMIN_EMAILS=
# Optional S3-compatible image storage. Local development uses .data/uploads.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set to 1 only behind one trusted proxy which replaces forwarded headers.
TRUST_PROXY=0
# Buy Me a Coffee links are external. No payment API keys are required.
